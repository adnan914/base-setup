NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000

JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Use the Supabase Postgres connection string in production.
# For local docker-compose: postgresql://postgres:postgres@localhost:5432/nestjs_app
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs_app
DATABASE_SSL=false

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User
