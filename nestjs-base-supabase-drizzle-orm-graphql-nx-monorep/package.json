{
  "name": "base_setup",
  "version": "1.0.0",
  "author": "Your Name",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nx run-many -t build -p storefront-api admin-api",
    "build:storefront": "nx build storefront-api",
    "build:admin": "nx build admin-api",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"test/**/*.ts\"",
    "start": "npm run start:storefront",
    "start:storefront": "nx serve storefront-api",
    "start:admin": "cross-env PORT=3001 nx serve admin-api",
    "start:dev": "npm run start:storefront",
    "start:prod": "node dist/apps/storefront-api/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "cross-env NODE_ENV=test drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register libs/backend/database/src/seed.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^13.4.2",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@supabase/supabase-js": "^2.75.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cross-env": "^10.1.0",
    "drizzle-orm": "^0.45.2",
    "graphql": "^16.14.0",
    "helmet": "^8.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.3.0",
    "winston": "^3.18.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.8",
    "@nestjs/testing": "^11.1.6",
    "@nx/eslint": "^22.7.2",
    "@nx/js": "^22.7.2",
    "@nx/nest": "^22.7.2",
    "@nx/node": "^22.7.2",
    "@nx/web": "22.7.2",
    "@nx/webpack": "^22.7.2",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.7.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.2.0",
    "nx": "22.7.2",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "webpack-cli": "^7.0.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@/database$": "<rootDir>/libs/backend/database/src/index.ts",
      "^@/database/(.*)$": "<rootDir>/libs/backend/database/src/$1",
      "^@/features/auth$": "<rootDir>/libs/backend/auth/src/index.ts",
      "^@/features/auth/(.*)$": "<rootDir>/libs/backend/auth/src/$1",
      "^@/features/users$": "<rootDir>/libs/backend/users/src/index.ts",
      "^@/features/users/(.*)$": "<rootDir>/libs/backend/users/src/$1",
      "^@/shared/(.*)$": "<rootDir>/libs/backend/common/src/shared/$1",
      "^@/config/(.*)$": "<rootDir>/libs/backend/common/src/config/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.nx/",
      "<rootDir>/dist/"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  },
  "nx": {}
}
