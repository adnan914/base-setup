{
  "name": "nx-nest-ecommerce-microservices",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "nx": "nx",
    "build": "nx run-many -t build --all",
    "start:dev": "concurrently \"yarn start:user\" \"yarn start:auth\" \"yarn start:gateway\"",
    "start:gateway": "nx serve api-gateway",
    "start:auth": "nx serve auth-service",
    "start:user": "nx serve user-service",
    "lint": "nx run-many -t lint --all",
    "test": "nx run-many -t test --all",
    "test:ci": "nx run-many -t test --all --ci",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "prisma:generate": "prisma generate --schema libs/database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema libs/database/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema libs/database/prisma/schema.prisma",
    "proto:generate": "grpc_tools_node_protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=libs/contracts/src/generated --ts_proto_opt=nestJs=true,addGrpcMetadata=true,outputServices=grpc-js,esModuleInterop=true -I proto proto/*.proto"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.4.15",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^5.22.0",
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "bcrypt": "^5.1.1",
    "cache-manager": "^5.7.6",
    "cache-manager-redis-yet": "^5.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "nats": "^2.29.2",
    "opossum": "^8.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nx/eslint": "^20.2.2",
    "@nx/jest": "^20.2.2",
    "@nx/js": "^20.2.2",
    "@nx/nest": "^20.2.2",
    "@nx/node": "^20.2.2",
    "@nx/workspace": "^20.2.2",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/opossum": "^8.1.8",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.16.0",
    "grpc-tools": "^1.12.4",
    "jest": "^29.7.0",
    "nx": "^20.2.2",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.6.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  }
}
