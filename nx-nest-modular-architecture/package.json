{
  "name": "@base-setup/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d data-source.ts",
    "migration:generate": "yarn run typeorm -- migration:generate",
    "migration:run": "yarn run typeorm -- migration:run",
    "migration:run:js": "node ./node_modules/typeorm/cli.js -d dist/data-source.js migration:run",
    "migration:revert": "yarn run typeorm -- migration:revert",
    "db:setup": "yarn run migration:run",
    "dev": "nx reset && nx serve api-gateway",
    "dev:gateway": "nx serve api-gateway",
    "dev:auth": "nx serve auth-service",
    "dev:user": "nx serve user-service",
    "dev:modular": "nx run-many --target=serve --projects=api-gateway,auth-service,user-service --parallel=3",
    "build": "nx build api-gateway",
    "build:gateway": "nx build api-gateway",
    "build:auth": "nx build auth-service",
    "build:user": "nx build user-service",
    "build:migrations": "tsc -p tsconfig.migrations.json",
    "build:full": "nx run-many --target=build --projects=api-gateway,auth-service,user-service --parallel=3 && yarn build:migrations && tsc-alias -p tsconfig.migrations.json",
    "db:setup:prod": "yarn migration:run:js",
    "smoke:modular": "node scripts/smoke-modular.js",
    "smoke:modular:run": "bash scripts/run-modular-smoke.sh",
    "ci:modular:static": "npx tsc -p apps/auth-service/tsconfig.app.json --noEmit && npx tsc -p apps/user-service/tsconfig.app.json --noEmit && npx tsc -p apps/api-gateway/tsconfig.app.json --noEmit && npx eslint apps libs scripts --ext .ts,.js,.mjs"
  },
  "private": true,
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1026.0",
    "@aws-sdk/s3-request-presigner": "^3.1033.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/typeorm": "^10.0.2",
    "axios": "^1.6.0",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "22.5.0",
    "@nx/eslint-plugin": "22.5.0",
    "@nx/jest": "22.5.0",
    "@nx/js": "22.5.0",
    "@nx/nest": "22.5.0",
    "@nx/node": "22.5.0",
    "@nx/web": "22.5.0",
    "@nx/webpack": "22.5.0",
    "@nx/workspace": "22.5.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^30.0.2",
    "jest-environment-node": "^30.0.2",
    "jest-util": "^30.0.2",
    "nx": "22.5.0",
    "prettier": "~3.6.2",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tsc-alias": "^1.8.10",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "webpack": "^5.105.4",
    "acorn-import-phases": "^1.0.4",
    "webpack-cli": "^5.1.4"
  }
}
