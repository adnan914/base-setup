NODE_ENV=development
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000
HOST=127.0.0.1
TRUST_PROXY=false
SWAGGER_ENABLED=true
BODY_SIZE_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=10
GATEWAY_PROXY_TIMEOUT_MS=5000
GATEWAY_PROXY_RETRIES=1
GATEWAY_PORT=5000
AUTH_SERVICE_PORT=5001
USER_SERVICE_PORT=5002
AUTH_SERVICE_URL=http://${HOST}:${AUTH_SERVICE_PORT}
USER_SERVICE_URL=http://${HOST}:${USER_SERVICE_PORT}

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me
DATABASE_NAME=base_setup_db
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=2
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_SLOW_QUERY_MS=1000

JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_ACCESS_EXPIRATION=1d
JWT_REFRESH_EXPIRATION=7d
PASSWORD_RESET_TOKEN_EXPIRY=3600000
PROD_URL=https://api.example.com/

S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
