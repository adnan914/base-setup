NODE_ENV=development
# PORT remains a shared fallback when an API-specific port is not set.
PORT=3000
ECOMMERCE_API_PORT=3000
ADMIN_API_PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
SWAGGER_ENABLED=true
LOG_LEVEL=info

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Use the Supabase Postgres connection string in production.
# For local docker-compose: postgresql://postgres:postgres@localhost:5432/nestjs_app
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs_app
# E2E tests only. Keep a visibly isolated database name containing "test".
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nestjs_app_test
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User
