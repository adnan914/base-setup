{
  "name": "admin-api",
  "projectType": "application",
  "sourceRoot": "apps/admin-api/src",
  "implicitDependencies": ["backend"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nest build admin-api"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nest start admin-api --watch"
      }
    }
  },
  "tags": ["scope:admin", "type:app"]
}
