{
  "name": "base_setup",
  "version": "1.0.0",
  "author": "Your Name",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "cross-env NX_ISOLATE_PLUGINS=false nx run-many -t build --projects=ecommerce-api,admin-api",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"test/**/*.ts\"",
    "start": "cross-env NX_ISOLATE_PLUGINS=false nx serve ecommerce-api",
    "start:admin": "cross-env NX_ISOLATE_PLUGINS=false nx serve admin-api",
    "start:dev": "cross-env NODE_ENV=development NX_ISOLATE_PLUGINS=false nx serve ecommerce-api",
    "start:dev:admin": "cross-env NODE_ENV=development NX_ISOLATE_PLUGINS=false nx serve admin-api",
    "start:debug": "nest start ecommerce-api --debug --watch",
    "start:prod:ecommerce": "node dist/apps/ecommerce-api/apps/ecommerce-api/src/main",
    "start:prod:admin": "node dist/apps/admin-api/apps/admin-api/src/main",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:local:db": "docker compose up -d db-test",
    "test:e2e:local:run": "npm run db:migrate:test && npm run test:e2e -- --runInBand",
    "test:e2e:local": "npm run test:e2e:local:db && npm run test:e2e:local:run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "cross-env NODE_ENV=test drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register libs/backend/src/database/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@supabase/supabase-js": "^2.75.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.11.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cross-env": "^10.1.0",
    "helmet": "^8.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.18.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.8",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.7.1",
    "@types/pg": "^8.15.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "drizzle-kit": "^0.31.5",
    "jest": "^30.2.0",
    "nx": "^21.6.5",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/libs/backend/src/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
